{
  "expo": {
    "name": "Zayzy Games",
    "slug": "zayzy-games",
    "owner": "amanikbt1",
    "version": "1.0.3",
    "description": "Zayzy Games - offline",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "zayzy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amanikbt1.zayzygame",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.amanikbt1.zayzygame",
      "versionCode": 4,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B21B6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ],
    "cli": {
      "appVersionSource": "remote"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4ce22158-5100-46e0-9f83-b77c7bfe97bb"
      }
    }
  }
}
