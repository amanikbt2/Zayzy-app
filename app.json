{
  "expo": {
    "name": "Zayzy Games",
    "slug": "zayzy-games",
    "version": "1.0.0",
    "description": "Zayzy Games - offline",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "zayzy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amanikbt1.zayzy",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.amanikbt1.zayzy",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B21B6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
