{
  "expo": {
    "name": "Zayzy Games",
    "slug": "zayzy-games",
    "version": "1.0.0",
    "description": "Zayzy Games - offline",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "zayzy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amanikbt1.zayzy"
    },
    "android": {
      "package": "com.amanikbt1.zayzy",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
